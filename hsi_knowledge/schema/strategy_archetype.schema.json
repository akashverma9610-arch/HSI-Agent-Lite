{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hsi-agent-lite.local/schema/strategy_archetype.schema.json",
  "title": "Non-runtime strategy archetype knowledge contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["strategy_archetype_id", "name", "version", "primary_family", "secondary_families", "aliases", "typical_horizon_description", "horizon_authority", "thesis", "analysis_stages", "dependency_strengths", "primary_dependencies", "secondary_dependencies", "optional_dependencies", "required_evidence_families", "optional_evidence_families", "future_evidence_dependencies", "required_diagnostics", "optional_diagnostics", "context_diagnostics", "quarantined_diagnostics", "required_gates", "gate_applicability_status", "gate_fail_override_allowed", "score_relationship", "entry_timing_role", "valuation_role", "catalyst_role", "portfolio_role", "broker_order_authority", "authority_origin", "authority_status", "lifecycle", "review_status", "activation_status", "runtime_status", "requirements_are_design_only", "blockers", "provenance", "legacy_commit", "legacy_sources", "notes"],
  "properties": {
    "strategy_archetype_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "primary_family": {"$ref": "#/$defs/family"},
    "secondary_families": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/family"}},
    "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "typical_horizon_description": {"type": "string", "minLength": 1},
    "horizon_authority": {"enum": ["INTENDED_ONLY_NOT_VALIDATED", "VALIDATED_BY_APPROVED_POLICY"]},
    "thesis": {"type": "string", "minLength": 1},
    "analysis_stages": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
    "dependency_strengths": {"type": "object", "additionalProperties": false, "required": ["FUNDAMENTALS", "EARNINGS", "TECHNICALS", "VALUATION", "CATALYST_NEWS", "SECTOR_MACRO", "FLOW", "BALANCE_SHEET_CASH_FLOW", "MANAGEMENT_GOVERNANCE", "LIQUIDITY_EXITABILITY"], "properties": {"FUNDAMENTALS": {"$ref": "#/$defs/strength"}, "EARNINGS": {"$ref": "#/$defs/strength"}, "TECHNICALS": {"$ref": "#/$defs/strength"}, "VALUATION": {"$ref": "#/$defs/strength"}, "CATALYST_NEWS": {"$ref": "#/$defs/strength"}, "SECTOR_MACRO": {"$ref": "#/$defs/strength"}, "FLOW": {"$ref": "#/$defs/strength"}, "BALANCE_SHEET_CASH_FLOW": {"$ref": "#/$defs/strength"}, "MANAGEMENT_GOVERNANCE": {"$ref": "#/$defs/strength"}, "LIQUIDITY_EXITABILITY": {"$ref": "#/$defs/strength"}}},
    "primary_dependencies": {"$ref": "#/$defs/dimensions"},
    "secondary_dependencies": {"$ref": "#/$defs/dimensions"},
    "optional_dependencies": {"$ref": "#/$defs/dimensions"},
    "required_evidence_families": {"$ref": "#/$defs/ids"},
    "optional_evidence_families": {"$ref": "#/$defs/ids"},
    "future_evidence_dependencies": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["dependency_id", "status", "reason"], "properties": {"dependency_id": {"type": "string", "minLength": 1}, "status": {"const": "UNAVAILABLE"}, "reason": {"type": "string", "minLength": 1}}}},
    "required_diagnostics": {"$ref": "#/$defs/diagnostics"},
    "optional_diagnostics": {"$ref": "#/$defs/diagnostics"},
    "context_diagnostics": {"$ref": "#/$defs/diagnostics"},
    "quarantined_diagnostics": {"$ref": "#/$defs/diagnostics"},
    "required_gates": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "gate_applicability_status": {"enum": ["UNRESOLVED_UNTIL_APPROVED_POLICY_AND_ACTION_CONTEXT", "RESOLVED_BY_APPROVED_POLICY"]},
    "gate_fail_override_allowed": {"const": false},
    "score_relationship": {"type": "object", "additionalProperties": false, "required": ["global_score_role", "future_archetype_score_status", "universal_minimum", "replaces_global_score", "description"], "properties": {"global_score_role": {"const": "CONTEXT_ONLY"}, "future_archetype_score_status": {"enum": ["NOT_IMPLEMENTED", "SEPARATELY_APPROVED_RUNTIME"]}, "universal_minimum": {"type": "null"}, "replaces_global_score": {"const": false}, "description": {"type": "string", "minLength": 1}}},
    "entry_timing_role": {"$ref": "#/$defs/role"},
    "valuation_role": {"$ref": "#/$defs/role"},
    "catalyst_role": {"$ref": "#/$defs/role"},
    "portfolio_role": {"enum": ["RESEARCH_CONTEXT_ONLY", "APPROVED_REVIEW_CONTEXT_ONLY"]},
    "broker_order_authority": {"const": false},
    "authority_origin": {"enum": ["LEGACY_AUTHORITY", "LEGACY_RESEARCH", "FOUNDER_DESIGN", "COMPOSITE_DERIVATION"]},
    "authority_status": {"enum": ["AUTHORITATIVE_ACCEPTED", "LATEST_ACCEPTED_WITH_LIMITATIONS", "PROPOSED_NOT_ACTIVE", "CONFLICT_REVIEW_REQUIRED"]},
    "lifecycle": {"enum": ["EXTRACTED_DRAFT", "REVIEW_REQUIRED", "APPROVED_FOR_LITE", "ACTIVE", "INACTIVE"]},
    "review_status": {"enum": ["IN_REVIEW", "HUMAN_APPROVED"]},
    "activation_status": {"enum": ["NOT_ACTIVE", "ACTIVE"]},
    "runtime_status": {"enum": ["NOT_IMPLEMENTED_IN_LITE", "IMPLEMENTED_IN_LITE"]},
    "requirements_are_design_only": {"type": "boolean"},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["origin_kind", "reference"], "properties": {"origin_kind": {"enum": ["TASK_008_USER_BRIEF", "LEGACY_READ_ONLY", "LITE_PRIOR_KNOWLEDGE"]}, "reference": {"type": "string", "minLength": 1}}}},
    "legacy_commit": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
    "legacy_sources": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "notes": {"type": "string"}
  },
  "$defs": {
    "family": {"enum": ["FAMILY_A_BUSINESS_EARNINGS", "FAMILY_B_PRICE_FLOW", "FAMILY_C_RECOVERY_RERATING", "FAMILY_D_INDUSTRY_CYCLE", "FAMILY_E_CATALYST", "FAMILY_F_STRUCTURAL_GROWTH"]},
    "strength": {"enum": ["PRIMARY", "SECONDARY", "OPTIONAL", "NOT_REQUIRED"]},
    "dimensions": {"type": "array", "uniqueItems": true, "items": {"enum": ["FUNDAMENTALS", "EARNINGS", "TECHNICALS", "VALUATION", "CATALYST_NEWS", "SECTOR_MACRO", "FLOW", "BALANCE_SHEET_CASH_FLOW", "MANAGEMENT_GOVERNANCE", "LIQUIDITY_EXITABILITY"]}},
    "ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "diagnostics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^D(0[1-9]|[1-5][0-9]|6[01])$"}},
    "role": {"enum": ["CORE", "CONFIRMATION", "CONSTRAINT", "CONTEXT_ONLY", "UNAVAILABLE"]}
  },
  "allOf": [
    {"if": {"properties": {"activation_status": {"const": "NOT_ACTIVE"}}, "required": ["activation_status"]}, "then": {"properties": {"blockers": {"minItems": 1}}}},
    {"if": {"properties": {"authority_origin": {"const": "FOUNDER_DESIGN"}}, "required": ["authority_origin"]}, "then": {"properties": {"authority_status": {"const": "PROPOSED_NOT_ACTIVE"}, "activation_status": {"const": "NOT_ACTIVE"}}}},
    {"if": {"properties": {"lifecycle": {"const": "ACTIVE"}}, "required": ["lifecycle"]}, "then": {"properties": {"authority_status": {"enum": ["AUTHORITATIVE_ACCEPTED", "LATEST_ACCEPTED_WITH_LIMITATIONS"]}, "review_status": {"const": "HUMAN_APPROVED"}, "activation_status": {"const": "ACTIVE"}, "runtime_status": {"const": "IMPLEMENTED_IN_LITE"}, "requirements_are_design_only": {"const": false}, "horizon_authority": {"const": "VALIDATED_BY_APPROVED_POLICY"}, "gate_applicability_status": {"const": "RESOLVED_BY_APPROVED_POLICY"}, "blockers": {"maxItems": 0}}}},
    {"if": {"properties": {"activation_status": {"const": "ACTIVE"}}, "required": ["activation_status"]}, "then": {"properties": {"lifecycle": {"const": "ACTIVE"}}}},
    {"if": {"properties": {"legacy_sources": {"minItems": 1}}, "required": ["legacy_sources"]}, "then": {"properties": {"legacy_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}}}
  ]
}
