{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hsi-agent-lite.local/schema/diagnostic.schema.json",
  "title": "Diagnostic details profile; validate with knowledge envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["diagnostic_id", "canonical_name", "version", "authority", "lifecycle", "evidence_dependencies", "evaluation_type", "result_semantics", "criticality", "score_relationship", "gate_relationship", "strategy_relationship", "provenance", "limitations"],
  "properties": {
    "diagnostic_id": {"type": "string", "minLength": 1},
    "canonical_name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "authority": {"enum": ["AUTHORITATIVE_ACCEPTED", "LATEST_ACCEPTED_WITH_LIMITATIONS", "PROPOSED_NOT_ACTIVE", "HISTORICAL_ONLY", "OBSOLETE_OR_SUPERSEDED", "CONFLICT_REVIEW_REQUIRED", "NOT_FOUND"]},
    "lifecycle": {"enum": ["INVENTORIED", "EXTRACTED_DRAFT", "REVIEW_REQUIRED", "APPROVED_FOR_LITE", "ACTIVE", "INACTIVE", "QUARANTINED", "SUPERSEDED"]},
    "evidence_dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evaluation_type": {"enum": ["PURE_CONSUMER", "JUSTIFIED_UNIQUE_CHECK", "COMPOSITE_RECONCILIATION", "QUARANTINED_DUPLICATE", "UNRESOLVED"]},
    "result_semantics": {"type": "object", "additionalProperties": false, "required": ["PASS", "CAUTION", "FAIL", "UNKNOWN"], "properties": {"PASS": {"type": "string", "minLength": 1}, "CAUTION": {"type": "string", "minLength": 1}, "FAIL": {"type": "string", "minLength": 1}, "UNKNOWN": {"type": "string", "minLength": 1}}},
    "criticality": {"enum": ["CRITICAL", "NON_CRITICAL", "CONTEXT_ONLY"]},
    "score_relationship": {"type": "string", "minLength": 1},
    "gate_relationship": {"type": "string", "minLength": 1},
    "strategy_relationship": {"type": "string", "minLength": 1},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {"if": {"properties": {"lifecycle": {"enum": ["APPROVED_FOR_LITE", "ACTIVE"]}}}, "then": {"properties": {"authority": {"enum": ["AUTHORITATIVE_ACCEPTED", "LATEST_ACCEPTED_WITH_LIMITATIONS"]}, "evaluation_type": {"enum": ["PURE_CONSUMER", "JUSTIFIED_UNIQUE_CHECK", "COMPOSITE_RECONCILIATION"]}}}},
    {"if": {"properties": {"evaluation_type": {"enum": ["QUARANTINED_DUPLICATE", "UNRESOLVED"]}}}, "then": {"properties": {"lifecycle": {"const": "QUARANTINED"}}}}
  ]
}
