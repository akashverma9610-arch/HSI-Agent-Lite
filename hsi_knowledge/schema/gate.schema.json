{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hsi-agent-lite.local/schema/gate.schema.json",
  "title": "Gate details profile; validate with knowledge envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["gate_id", "canonical_name", "version", "authority", "lifecycle", "purpose", "required_evidence", "required_diagnostics", "pass_condition", "fail_condition", "unknown_behavior", "criticality", "score_interaction", "strategy_interaction", "portfolio_context", "known_limitations", "broker_order_authority", "score_or_llm_override_allowed", "provenance"],
  "properties": {
    "gate_id": {"type": "string", "minLength": 1},
    "canonical_name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "authority": {"enum": ["AUTHORITATIVE_ACCEPTED", "LATEST_ACCEPTED_WITH_LIMITATIONS", "PROPOSED_NOT_ACTIVE", "HISTORICAL_ONLY", "OBSOLETE_OR_SUPERSEDED", "CONFLICT_REVIEW_REQUIRED", "NOT_FOUND"]},
    "lifecycle": {"enum": ["INVENTORIED", "EXTRACTED_DRAFT", "REVIEW_REQUIRED", "APPROVED_FOR_LITE", "ACTIVE", "INACTIVE", "QUARANTINED", "SUPERSEDED"]},
    "purpose": {"type": "string", "minLength": 1},
    "required_evidence": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "required_diagnostics": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^D(0[1-9]|[1-5][0-9]|6[01])$"}},
    "pass_condition": {"$ref": "#/$defs/condition"},
    "fail_condition": {"$ref": "#/$defs/condition"},
    "unknown_behavior": {"const": "BLOCK"},
    "criticality": {"enum": ["CRITICAL", "NON_CRITICAL"]},
    "score_interaction": {"type": "string", "minLength": 1},
    "strategy_interaction": {"type": "string", "minLength": 1},
    "portfolio_context": {"type": "string", "minLength": 1},
    "known_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "broker_order_authority": {"const": false},
    "score_or_llm_override_allowed": {"const": false},
    "provenance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "condition": {"type": "object", "additionalProperties": false, "required": ["policy_reference", "description"], "properties": {"policy_reference": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}}
  },
  "allOf": [
    {"if": {"properties": {"lifecycle": {"enum": ["APPROVED_FOR_LITE", "ACTIVE"]}}}, "then": {"properties": {"authority": {"enum": ["AUTHORITATIVE_ACCEPTED", "LATEST_ACCEPTED_WITH_LIMITATIONS"]}}}}
  ]
}
